{
    "manifest_version": 3,
    "name": "Connection Checker",
    "version": "1.0",
    "description": "Checks connection to https://www.google.com and displays latency.",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "alarms"
    ],
    "host_permissions": [
        "https://www.google.com/*"
    ],
    "action": {
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        },
        "default_title": "Connection Checker"
    },
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}